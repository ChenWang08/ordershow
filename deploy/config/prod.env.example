# Use separate production resources/credentials; do not point to the test database/bucket.
SPRING_PROFILES_ACTIVE=prod
# Keep UTC driver/session settings; review historical times before upgrading.
DB_URL=jdbc:mysql://REPLACE_ME:3306/order_show?serverTimezone=UTC&sslMode=VERIFY_IDENTITY
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
H5_SESSION_CACHE_TTL_MS=0
# Require V041 and completed summary repair/check for an existing database.
DASHBOARD_SUMMARY_ENABLED=true
DASHBOARD_SUMMARY_ACTIVITIES=
REDIS_HOST=REPLACE_ME
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_ME
REDIS_SSL_ENABLED=true
STORAGE_PROVIDER=oss
STORAGE_ENDPOINT=https://REPLACE_ME
STORAGE_BUCKET=REPLACE_ME
STORAGE_ACCESS_KEY=REPLACE_ME
STORAGE_SECRET_KEY=REPLACE_ME
OSS_REGION=REPLACE_ME
PUBLIC_ORIGIN=https://REPLACE_ME
REALTIME_CHANNEL=order-show:prod:events
PHONE_HMAC_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PHONE_ENCRYPTION_KEY=REPLACE_ME_WITH_ANOTHER_RANDOM_SECRET
