# Use separate production resources/credentials; do not point to the test database/bucket.
SPRING_PROFILES_ACTIVE=prod
# Keep UTC driver/session settings; review historical times before upgrading.
DB_URL=jdbc:mysql://REPLACE_ME:3306/order_show?serverTimezone=UTC&sslMode=VERIFY_IDENTITY
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=2
H5_SESSION_CACHE_TTL_MS=0
ACTIVITY_DELETION_BATCH_SIZE=500
ACTIVITY_DELETION_MAX_RETRIES=5
ACTIVITY_DELETION_BATCH_INTERVAL_MS=500
# Require V049 and completed summary repair/check for an existing database.
DASHBOARD_SUMMARY_ENABLED=true
DASHBOARD_SUMMARY_ACTIVITIES=
REDIS_HOST=REPLACE_ME
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_ME
REDIS_SSL_ENABLED=true
STORAGE_PROVIDER=oss
STORAGE_ENDPOINT=https://REPLACE_ME
STORAGE_BUCKET=REPLACE_ME
STORAGE_ACCESS_KEY=REPLACE_ME
STORAGE_SECRET_KEY=REPLACE_ME
OSS_REGION=REPLACE_ME
PUBLIC_ORIGIN=https://REPLACE_ME
REALTIME_CHANNEL=order-show:prod:events
PHONE_HMAC_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PHONE_ENCRYPTION_KEY=REPLACE_ME_WITH_ANOTHER_RANDOM_SECRET

# Bounded per-replica settings; budget all replicas plus rolling-update surge.
ACTIVITY_INFO_CHANNEL=order-show:prod:events:activity-info:v1
H5_CATALOG_CHANNEL=order-show:prod:events:product-catalog:v1
ACTIVITY_INFO_HEARTBEAT_MS=30000
ACTIVITY_INFO_MAX_CONNECTIONS=2000
H5_CATALOG_CACHE_ENABLED=true
H5_CATALOG_MAX_ACTIVITIES=32
H5_CATALOG_MAX_BYTES=33554432
H5_CATALOG_IDLE_SECONDS=600
H5_CATALOG_MAX_LOADS=4
H5_CATALOG_MAX_WAITERS=128
H5_CATALOG_WAIT_MILLIS=5000
LOTTERY_PREVIEW_CONCURRENCY=2
LOTTERY_DRAW_CONCURRENCY=1
LOTTERY_QUERY_TIMEOUT_SECONDS=8

# Public HTTP metadata: bounded per replica; DB version is shared.
ACTIVITY_HTTP_REVISION_TTL_MS=2000
ACTIVITY_HTTP_MAX_ACTIVITIES=64
ACTIVITY_HTTP_MAX_LOADS=2
ACTIVITY_HTTP_MAX_WAITERS=128
ACTIVITY_HTTP_WAIT_MS=3000

# H5 admission and shared customer throttling.
H5_WRITE_MAX_WAITERS=50
H5_WRITE_WAIT_TIMEOUT_MS=12000
H5_CUSTOMER_WRITE_RATE_LIMIT_ENABLED=true
H5_CUSTOMER_WRITE_WINDOW_MS=10000
H5_CUSTOMER_WRITE_MAX_OPERATIONS=3
H5_CUSTOMER_WRITE_MAX_REQUESTS=20
H5_CUSTOMER_WRITE_REDIS_BUDGET_MS=200
H5_CUSTOMER_WRITE_REDIS_RECOVERY_MS=5000
