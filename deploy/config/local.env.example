# Existing root .env.example + docker-compose.yml remain the normal local entry point.
SPRING_PROFILES_ACTIVE=local
STORAGE_PROVIDER=minio
DB_MIGRATION_ENABLED=true
ACTIVITY_DELETION_BATCH_SIZE=500
ACTIVITY_DELETION_MAX_RETRIES=5
ACTIVITY_DELETION_BATCH_INTERVAL_MS=500
REALTIME_CHANNEL=order-show:local:events
# Legacy S3_* variables still configure MinIO; no cloud values are required locally.
# When reusing existing local data, preserve the original PHONE_HMAC_KEY and
# PHONE_ENCRYPTION_KEY in the root .env (Git-ignored); never replace them with defaults.
