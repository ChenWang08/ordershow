# 复制为 .env 后按部署环境修改；不要把真实密钥提交到 Git。
DB_PASSWORD=order_show_local
MYSQL_ROOT_PASSWORD=order_show_root_local
S3_ACCESS_KEY=order_show_minio
S3_SECRET_KEY=order_show_minio_2026
PHONE_HMAC_KEY=replace-with-a-long-random-secret
PHONE_ENCRYPTION_KEY=replace-with-another-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Allowed browser origins, comma-separated. Include the scheme and frontend port.
# Example: PUBLIC_ORIGIN=http://localhost:3000,http://192.168.1.10:3000
PUBLIC_ORIGIN=http://localhost:3000

MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
HTTP_MAX_THREADS=40
H5_WARMUP_ENABLED=true
# Per backend replica; bytes are a conservative cache accounting estimate, not a heap quota.
H5_CATALOG_CACHE_ENABLED=true
H5_CATALOG_MAX_ACTIVITIES=32
H5_CATALOG_MAX_BYTES=33554432
H5_CATALOG_IDLE_SECONDS=600
H5_CATALOG_MAX_LOADS=8
H5_CATALOG_MAX_WAITERS=512
H5_CATALOG_WAIT_MILLIS=5000
# 看板统计汇总读模型（order_dashboard_stat / order_dashboard_product_line_stat）。
# 打开后看板、战报、排行改为读汇总表，不再每次刷新都全量聚合全部订单明细。
# 注意：仅打开开关不会提速。未回填的订单仍走明细回退分支，新 SQL 会同时扫描明细与汇总表，可能比原来更慢。
# 注意：必须先开开关，再回填。DashboardSummaryStore.refresh() 在开关关闭时直接返回，关着回填是空跑。
# 回填与核对（按活动逐个执行；该 CLI 不启动 HTTP、调度器、Flyway 或任何初始化例程）：
#   java -cp "解包后的 BOOT-INF/classes:BOOT-INF/lib/*" com.fengyi.ordershow.maintenance.DashboardSummaryCommand rebuild <activityId>
#   同一命令把 rebuild 换成 check，输出 differences=0 才算汇总与明细一致。
# 直接 java -cp app.jar 会失败：Spring Boot fat JAR 的类在 BOOT-INF/classes 下，需要先解包再组 classpath。
# 只需回填进行中的活动；已结束或已归档的活动读取冻结快照，汇总表对它们没有意义。
# 开关打开后，新订单在自身事务内自动维护汇总行，不需要额外的定时任务。
# 回退：删除下面的变量即恢复原明细读路径；汇总数据可保留不管，不影响任何统计结果。
# 留空表示对所有活动生效；填写则仅对列出的活动生效（activityId 逗号分隔），可用于灰度。
DASHBOARD_SUMMARY_ENABLED=false
DASHBOARD_SUMMARY_ACTIVITIES=
# Per backend instance. Retain this example's local override; the code/Compose default is 36.
H5_WRITE_CONCURRENCY=12
H5_WRITE_MAX_WAITERS=50
H5_WRITE_WAIT_TIMEOUT_MS=12000
# Activity/customer rate counters are shared by backend replicas using the same Redis.
H5_CUSTOMER_WRITE_RATE_LIMIT_ENABLED=true
H5_CUSTOMER_WRITE_WINDOW_MS=10000
H5_CUSTOMER_WRITE_MAX_OPERATIONS=3
H5_CUSTOMER_WRITE_MAX_REQUESTS=20
H5_CUSTOMER_WRITE_REDIS_BUDGET_MS=200
H5_CUSTOMER_WRITE_REDIS_RECOVERY_MS=5000
# 抽奖资源保护，按每个后端实例计算；不填写也使用以下默认值。
# 手动试算与商品选项查询共用的同时执行名额。
LOTTERY_PREVIEW_CONCURRENCY=2
# 正式开奖的独立同时执行名额，不与试算共用。
LOTTERY_DRAW_CONCURRENCY=1
# 候选及商品选项的单条数据库查询超时（秒），不是整轮开奖超时。
LOTTERY_QUERY_TIMEOUT_SECONDS=8
VIRTUAL_THREADS_ENABLED=true
FRONTEND_PORT=3000
# Public activity metadata HTTP cache (per backend replica; shared DB is the version authority).
ACTIVITY_HTTP_REVISION_TTL_MS=2000
ACTIVITY_HTTP_MAX_ACTIVITIES=64
ACTIVITY_HTTP_MAX_LOADS=2
ACTIVITY_HTTP_MAX_WAITERS=128
ACTIVITY_HTTP_WAIT_MS=3000
# 配置复用：只在创建时复制，所有实例共用一个执行名额；额外数据库连接最多每实例 1 个。
# 行数包含商品、客户、轮次及其子配置，不只是商品条数。
ACTIVITY_COPY_MAX_ROWS=20000
ACTIVITY_COPY_MAX_SNAPSHOT_BYTES=8388608
ACTIVITY_COPY_QUEUE_LIMIT=10
# 本地默认仍为 MinIO，沿用现有 S3_* 配置。
STORAGE_PROVIDER=minio
