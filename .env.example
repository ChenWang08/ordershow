# 复制为 .env 后按部署环境修改；不要把真实密钥提交到 Git。
DB_PASSWORD=order_show_local
MYSQL_ROOT_PASSWORD=order_show_root_local
S3_ACCESS_KEY=order_show_minio
S3_SECRET_KEY=order_show_minio_2026
PHONE_HMAC_KEY=replace-with-a-long-random-secret
PHONE_ENCRYPTION_KEY=replace-with-another-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Allowed browser origins, comma-separated. Include the scheme and frontend port.
# Example: PUBLIC_ORIGIN=http://localhost:3000,http://192.168.1.10:3000
PUBLIC_ORIGIN=http://localhost:3000

MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
HTTP_MAX_THREADS=40
H5_WARMUP_ENABLED=true
H5_WRITE_CONCURRENCY=12
VIRTUAL_THREADS_ENABLED=true
FRONTEND_PORT=3000
